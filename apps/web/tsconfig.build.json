{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/music/tracks/manifest.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../packages/game-protocol/tsconfig.build.json" },
    { "path": "../../packages/game-core/tsconfig.build.json" },
    { "path": "../../packages/game-data/tsconfig.build.json" },
    { "path": "../../packages/game-maps/tsconfig.build.json" },
    { "path": "../../packages/game-session/tsconfig.build.json" }
  ]
}
