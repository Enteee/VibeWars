{
  "name": "@vibewars/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus game server. Owns all simulation state.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "start": "node ./dist/main.js",
    "dev": "node --watch ./dist/main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.42",
    "@vibewars/game-core": "workspace:*",
    "@vibewars/game-protocol": "workspace:*",
    "colyseus": "0.18.10",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.6",
    "@types/express": "^5.0.6"
  }
}
