# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-types/
# The static Pages build the e2e suite previews (#103).
dist-static/
build/
*.tsbuildinfo

# devenv
.devenv*
devenv.local.nix
# Generated by devenv's git-hooks on every `devenv shell` (ADR-0021, #283).
/.pre-commit-config.yaml
.direnv/

# claude-bot: per-role bot tokens, message bus and git worktrees.
/.bots/

# A literal "undefined" directory is what you get when a script
# interpolates an unset variable into an output path. Never intentional,
# and easy to commit by accident.
/undefined/

# Test / coverage
coverage/
.vitest/
test-results/
playwright-report/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Skill-importer generated bundle: rebuilt from normalized/ by `pnpm run
# generate`/`pnpm run import`, never hand-edited. raw/ and normalized/ ARE
# committed (provenance + hand-auditable facts — see ADR-0004).
packages/game-data/generated/
